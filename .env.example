# Copy to .env in the repository root. Never commit .env or your actual key.
# Leave blank to run with local SQLite retrieval and no paid AI API calls.
# Free-tier Gemini (recommended for local testing). Do not add billing unless you intend to.
# Set AI_PROVIDER=ollama for no-key local AI or gemini for cloud Free Tier.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: paid OpenAI API instead. Set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
