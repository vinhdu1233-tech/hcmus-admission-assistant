# Copy to .env in the repository root. Never commit .env or your actual key.
# Leave blank to run with local SQLite retrieval and no paid AI API calls.
# Free-tier Gemini (recommended for local testing). Do not add billing unless you intend to.
# Set AI_PROVIDER=ollama for no-key local AI or gemini for cloud Free Tier.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: paid OpenAI API instead. Set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Account/calendar development (copy and fill locally; no real secrets in Git).
# Generate HCMUS_OTP_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
HCMUS_OTP_SECRET=
SMTP_MODE=mailhog
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=guide@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
# Use COOKIE_SECURE=1 when deploying behind HTTPS.
COOKIE_SECURE=0
# Default: sibling of admissions SQLite database. Set persistent path in deployment.
# HCMUS_PRODUCT_DB_PATH=/persistent/product.sqlite3
MONITOR_INTERVAL_HOURS=24
# Web Push keys must be generated/configured by operator. Private key stays server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
